{
  "schemaVersion": 1,
  "experimentId": "forgebench-calibration-v1",
  "budgetUsd": 70,
  "budgetSafetyFraction": 0.10,
  "gpuType": "NVIDIA RTX PRO 6000 Blackwell Server Edition",
  "gpuCount": 3,
  "cloudType": "ANY",
  "runsPerCell": 3,
  "parallelModels": 3,
  "profile": "optimized",
  "repairPolicy": {
    "maxAttempts": 3,
    "tokenLimit": null,
    "wallTimeLimit": "provider-budget",
    "feedbackBoundary": {
      "publicSources": [
        "tasks/*/seed/SPEC.md",
        "tasks/*/seed/test/public.test.mjs"
      ],
      "heldOutSources": [
        "evaluators/**",
        "validation/reference/**"
      ],
      "allowedFeedback": [
        "public requirement id",
        "public test name",
        "expected and observed public behavior",
        "safe stack trace"
      ],
      "prohibitedFeedback": [
        "held-out check names",
        "reference implementation details",
        "evaluator source or private output details"
      ]
    }
  },
  "historicalCompatibility": {
    "referenceChecksMustMatchExactly": true,
    "smallAndMediumCheckTolerance": 0,
    "largeTaskBands": {
      "qwen": { "minimumPassed": 16, "maximumPassed": 18 },
      "muse": { "minimumPassed": 14, "maximumPassed": 17 },
      "gemma": { "verifiedResultRequired": true, "minimumPassed": null }
    }
  },
  "promotionGates": {
    "criticalTaskConsecutiveFullPasses": 3,
    "noOrphanProcesses": true,
    "noSecretLeakage": true,
    "runpodCampaignSpendMaxUsd": 70,
    "p95WallTime": "report-only",
    "tokenUsage": "report-only",
    "energyUsage": "report-only"
  },
  "qualityGates": {
    "serviceErrorRateMax": 0.01,
    "toolErrorRateMax": 0.10,
    "candidateTaskRegressionMax": 0,
    "fullPassRequiredForOptimizationWinner": true
  }
}
